# =============================================================================
# hotaru — environment
# =============================================================================
# Secrets only. Anything the OWNER edits (bank account, payment instructions,
# alert address, store contact details) lives in the store_settings table and is
# edited from /admin — changing an account number must never need a deploy.
#
# NEXT_PUBLIC_* is compiled into the browser bundle. Never put a secret there.
# =============================================================================

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://ordmeqxctxvhpesbmexi.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME
# Server-only. Bypasses RLS entirely — used by the notification worker.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# GraphQL endpoint Apollo points at.
NEXT_PUBLIC_SUPABASE_GRAPHQL_URL=https://ordmeqxctxvhpesbmexi.supabase.co/graphql/v1

# --- ImageKit ---------------------------------------------------------------
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/yubjkbui8
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=public_REPLACE_ME
# Server-only. Signs client uploads via /api/upload-auth.
IMAGEKIT_PRIVATE_KEY=private_REPLACE_ME

# --- Resend (placeholders — supply when ready) ------------------------------
# The outbox works without these: triggers queue rows today, the worker drains
# them once a key exists. Nothing is lost in the meantime.
RESEND_API_KEY=re_REPLACE_ME
# Must be a domain verified in Resend, or sends are rejected.
# The display name and reply-to are configured in store_settings, not here.
RESEND_FROM_DOMAIN=REPLACE_ME.mn

# Shared secret guarding the cron endpoint that drains the outbox, so the route
# cannot be triggered by anyone who finds the URL.
NOTIFICATION_WORKER_SECRET=REPLACE_ME

# --- verify.mn (phone verification, Mongolia only) --------------------------
# Mobile-Originated SMS: the user texts a code we mint to shortcode 144773 from
# the number they are claiming. Without this key the checkout hides the phone
# option and falls back to email — it never silently treats a phone as verified.
# Each SMS costs the user 150₮; the developer earns 40₮ per verified phone.
VERIFY_MN_API_KEY=

# --- Social sign-in ---------------------------------------------------------
# Comma-separated list of providers that are ACTUALLY enabled in Supabase Auth.
# Buttons for anything not listed render disabled: signInWithOAuth navigates
# rather than returning an error, so an un-enabled provider would drop the
# shopper on a raw JSON error page. Enable in the dashboard, then add here.
NEXT_PUBLIC_OAUTH_PROVIDERS=

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# QPay QuickQR. All six or none — a partial set throws rather than silently
# disabling payments. There is no sandbox host for these credentials.
QPAY_BASE_URL=https://quickqr.qpay.mn
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_TERMINAL_ID=
QPAY_MERCHANT_ID=
# openssl rand -hex 32 — signs the order id carried in the callback URL
QPAY_CALLBACK_SECRET=

# Only for scripts/qpay-register-merchant.mjs, which runs once. Not read at runtime.
# Registered as an individual, so this is the owner's personal register number
# and name; HOTARU_BUSINESS_NAME is the trading name shown on the QR.
HOTARU_REGISTER_NUMBER=
HOTARU_FIRST_NAME=
HOTARU_LAST_NAME=
HOTARU_BUSINESS_NAME=hotaru
# QPay merchant category; 5699 = other apparel and accessory store.
HOTARU_MCC_CODE=5699
HOTARU_CITY=
HOTARU_DISTRICT=
HOTARU_ADDRESS=
HOTARU_PHONE=
HOTARU_EMAIL=
HOTARU_BANK_CODE=
HOTARU_ACCOUNT_NUMBER=
HOTARU_ACCOUNT_NAME=
